# ===== Required =====
JWT_SECRET=replace-with-a-strong-secret

# ===== Database (Amazon RDS Postgres, managed) =====
# RDS connections are encrypted in transit, so sslmode=require.
DATABASE_URL=postgres://<MASTER_USER>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=require

# ===== App host and port config =====
BACKEND_BASE_URL=https://api.<YOUR_DOMAIN>
BACKEND_PORT=8080
SERVER_ADDR=:8080

# Frontend is hosted on AWS Amplify; use its URL here.
FRONTEND_BASE_URL=https://app.<YOUR_DOMAIN>

# CORS (comma-separated). The Amplify frontend origin(s).
ALLOWED_ORIGINS=https://app.<YOUR_DOMAIN>

# Public base URL used when building absolute media/upload links.
PUBLIC_BASE_URL=https://api.<YOUR_DOMAIN>

# ===== Storage (Amazon S3) =====
# local or s3
STORAGE_DRIVER=s3
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== Optional 3rd-party integrations =====
TMDB_API_KEY=
STEAM_WEB_API_KEY=
STEAM_CALLBACK_REDIRECT_PATH=/settings
RAWG_API_KEY=
GOOGLE_BOOKS_API_KEY=
LASTFM_API_KEY=
LASTFM_API_SECRET=

# ===== Optional dev admin bootstrap =====
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_USERNAME=admin

# ===== Stripe (membership payments) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ===== Content moderation =====
# Set to "true" to enable AI-based content moderation via OpenAI Moderation API.
MODERATION_ENABLED=false
OPENAI_MODERATION_KEY=

# ===== AI Suggestions (v2, LLM-powered) =====
# Provider: "openai" or "anthropic". Leave empty to disable LLM suggestions (v1 SQL-based still works).
LLM_PROVIDER=
LLM_API_KEY=

# ===== Frontend build (set these in the AWS Amplify console, not in this file) =====
# The Next.js build reads BACKEND_BASE_URL and BACKEND_PORT to bake the NEXT_PUBLIC_* API URL.
# For the Amplify app (monorepo appRoot apps/web) set:
#   BACKEND_BASE_URL=https://api.<YOUR_DOMAIN>
#   BACKEND_PORT=443
