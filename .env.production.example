# ===== Required =====
JWT_SECRET=replace-with-a-strong-secret

# ===== Database =====
# Option A: External managed Postgres (Supabase, RDS, etc.) — used with docker-compose.prod.yml alone.
DATABASE_URL=postgres://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# Option B: Self-hosted Postgres in the same Compose stack — used with docker-compose.aws.yml.
# Uncomment the lines below (and comment out Option A) when running the AWS / Lightsail stack.
# The connection stays inside the Docker network, so sslmode=disable is correct.
# DATABASE_URL=postgres://completionist:<POSTGRES_PASSWORD>@db:5432/completionist?sslmode=disable
# POSTGRES_USER=completionist
# POSTGRES_PASSWORD=replace-with-a-strong-random-password
# POSTGRES_DB=completionist

# ===== App host and port config =====
BACKEND_BASE_URL=http://<YOUR_SERVER_IP_OR_API_DOMAIN>
BACKEND_PORT=8080
SERVER_ADDR=:8080

FRONTEND_BASE_URL=http://<YOUR_SERVER_IP_OR_FRONTEND_DOMAIN>
PORT=4000

# CORS (comma-separated)
ALLOWED_ORIGINS=http://<YOUR_SERVER_IP_OR_FRONTEND_DOMAIN>:4000

# Used when building the web image (compile-time)
WEB_BACKEND_BASE_URL=http://<YOUR_SERVER_IP_OR_API_DOMAIN>
WEB_BACKEND_PORT=8080

# ===== Optional 3rd-party integrations =====
TMDB_API_KEY=
STEAM_WEB_API_KEY=
STEAM_CALLBACK_REDIRECT_PATH=/settings
RAWG_API_KEY=
GOOGLE_BOOKS_API_KEY=
LASTFM_API_KEY=
LASTFM_API_SECRET=
PUBLIC_BASE_URL=http://<YOUR_SERVER_IP_OR_API_DOMAIN>:8080

# ===== Storage =====
# local or s3
STORAGE_DRIVER=local
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== Optional dev admin bootstrap =====
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_USERNAME=admin

# ===== Stripe (membership payments) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ===== Content moderation =====
# Set to "true" to enable AI-based content moderation via OpenAI Moderation API.
MODERATION_ENABLED=false
OPENAI_MODERATION_KEY=

# ===== AI Suggestions (v2, LLM-powered) =====
# Provider: "openai" or "anthropic". Leave empty to disable LLM suggestions (v1 SQL-based still works).
LLM_PROVIDER=
LLM_API_KEY=
